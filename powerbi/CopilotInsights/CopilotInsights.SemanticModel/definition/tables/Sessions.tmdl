/// One row per session: a person's prompts with less than 60 minutes between them, within one day in the reporting time zone.
table Sessions
	lineageTag: 9f930a8a-382f-547f-bf1b-7c963d62624e

	/// Number of Copilot sessions.
	measure Sessions = COUNTROWS ( Sessions )
		formatString: #,0
		lineageTag: e6014a17-c484-56c2-a343-eb53fc588734

	/// Average prompts in a session.
	measure 'Prompts per session' = DIVIDE ( SUM ( Sessions[PromptCount] ), [Sessions] )
		formatString: #,0.0
		lineageTag: c1fad6ba-606e-57af-813f-44f88678ff9e

	/// Sessions with more than one prompt.
	measure 'Multi-turn sessions' = CALCULATE ( [Sessions], Sessions[IsMultiTurn] = TRUE () )
		formatString: #,0
		lineageTag: 988d62ba-956e-5db1-b778-d4e69fd9e416

	column SessionKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 8d9de2bb-8d66-5f95-b027-22ea846b967d
		summarizeBy: none
		sourceColumn: SessionKey

	/// First prompt of the session, in the reporting time zone.
	column SessionStart
		dataType: dateTime
		formatString: General Date
		lineageTag: fe18b114-0646-5c93-867e-a371f7bb874e
		summarizeBy: none
		sourceColumn: SessionStart

	/// Last prompt of the session, in the reporting time zone.
	column SessionEnd
		dataType: dateTime
		formatString: General Date
		lineageTag: 45d28815-97a4-5939-ba7c-92e031889bc8
		summarizeBy: none
		sourceColumn: SessionEnd

	column DateKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: aa57c1f0-b854-5c43-a07d-26e5e60e6ea9
		summarizeBy: none
		sourceColumn: DateKey

	column UserKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 1e26ab90-22f0-5103-85df-4dacc0c60ab4
		summarizeBy: none
		sourceColumn: UserKey

	/// The app of the session's first prompt.
	column AppKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 03bc537f-fe3f-5983-8ba0-faacdc9ae567
		summarizeBy: none
		sourceColumn: AppKey

	column LicenceStatusKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f2b55163-7a86-582e-adf6-8a5c11bb6e66
		summarizeBy: none
		sourceColumn: LicenceStatusKey

	column PromptCount
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: e87c91ea-8aeb-5b7b-af65-ea4118588dcf
		summarizeBy: none
		sourceColumn: PromptCount

	/// Minutes from the first to the last prompt.
	column SpanMinutes
		dataType: double
		formatString: #,0.0
		lineageTag: 4ce1b0b2-0a00-5b8a-a3d5-43075831a9eb
		summarizeBy: none
		sourceColumn: SpanMinutes

	/// True when the session has more than one prompt.
	column IsMultiTurn
		dataType: boolean
		lineageTag: 2e42849f-fd95-53ff-abae-56e0b2c1b454
		summarizeBy: none
		sourceColumn: IsMultiTurn

	partition Sessions = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema = "bi", Item = "Sessions"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
