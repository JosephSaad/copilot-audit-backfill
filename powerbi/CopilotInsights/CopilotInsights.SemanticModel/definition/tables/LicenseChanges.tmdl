/// One row per Copilot SKU added to (+1) or removed from (-1) a person, from the directory audit log.
table LicenseChanges
	lineageTag: 0e69e79b-4a65-567c-afd1-5afb80933a35

	/// Copilot SKUs assigned in the period.
	measure 'Licenses added' = CALCULATE ( COUNTROWS ( LicenseChanges ), LicenseChanges[Change] = 1 )
		formatString: #,0
		lineageTag: a61bc91d-f57b-5667-9f51-308aacbbf64e

	/// Copilot SKUs removed in the period.
	measure 'Licenses removed' = CALCULATE ( COUNTROWS ( LicenseChanges ), LicenseChanges[Change] = -1 )
		formatString: #,0
		lineageTag: 60cd684e-9b34-5854-adc9-8d09f145a575

	/// When the license changed, UTC.
	column ChangedUtc
		dataType: dateTime
		formatString: General Date
		lineageTag: 742fb0e8-90bf-5728-8773-8e5e284c19dd
		summarizeBy: none
		sourceColumn: ChangedUtc

	column DateKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 41759007-c20f-5e56-be01-5af9039c27da
		summarizeBy: none
		sourceColumn: DateKey

	column UserKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 45c307c2-1aff-5f96-b306-f4e1197a8d88
		summarizeBy: none
		sourceColumn: UserKey

	column SkuKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: bcda54b7-3e4a-5143-9ad7-36bb5719b976
		summarizeBy: none
		sourceColumn: SkuKey

	/// +1 when the SKU was added, -1 when it was removed.
	column Change
		dataType: int64
		formatString: 0
		lineageTag: da6c707f-0ef5-5d2f-a09c-cb65ceadbebe
		summarizeBy: none
		sourceColumn: Change

	/// Who made the change.
	column ChangedBy
		dataType: string
		lineageTag: c125de73-1c51-5226-bff2-f079c8e89b7e
		summarizeBy: none
		sourceColumn: ChangedBy

	partition LicenseChanges = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema = "bi", Item = "LicenseChanges"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
