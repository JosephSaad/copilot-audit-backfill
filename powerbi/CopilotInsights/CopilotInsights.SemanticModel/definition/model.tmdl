model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SqlServer","SqlDatabase","RangeStart","RangeEnd","Interactions","Sessions","LicenseChanges","LicensedDays","Calendar","Users","Apps","Agents","Models","Skus","LicenseTypes","SensitivityLabels","AccessedResources","ResourceTypes","FileTypes","ResourceActions","Sites","AgentEvents","LicensePool","DepartmentWeek","ValueNames","UseCases","JobFamilies","EventMarkers","OrgSecurity","LicenseStatuses"]

annotation PBI_ProTooling = ["DevMode"]

ref table Interactions
ref table Sessions
ref table LicenseChanges
ref table LicensedDays
ref table Calendar
ref table Users
ref table Apps
ref table Agents
ref table Models
ref table Skus
ref table LicenseTypes
ref table SensitivityLabels
ref table AccessedResources
ref table ResourceTypes
ref table FileTypes
ref table ResourceActions
ref table Sites
ref table AgentEvents
ref table LicensePool
ref table DepartmentWeek
ref table ValueNames
ref table UseCases
ref table JobFamilies
ref table EventMarkers
ref table OrgSecurity
ref table LicenseStatuses

ref role Organization
ref role Departments
