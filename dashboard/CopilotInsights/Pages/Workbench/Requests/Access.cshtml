@page "/workbench/Requests/Access"
@model Governance.Web.Pages.Requests.AccessModel
@{
    ViewData["Title"] = "Use an approved Copilot service";
}
<div class="page-head">
    <div>
        <div class="crumbs"><a href="/workbench/Start">Start</a> › J1</div>
        <h1>Use an approved Copilot service</h1>
        <p class="lead">Routine access to Copilot Chat or Cowork goes through Microsoft Entra: you request the access package for your line of business and tier, and one of its delegated approvers decides in My Access. The Workbench does not ask a second time; it records the decision, attributes it to your funding owner and checks the funding is there.</p>
    </div>
</div>
<div class="card">
    <form method="get" class="form-grid">
        <div class="field">
            <label for="fo">Your funding owner <help k="j1.fundingowner">Worked out from your Entra cost center and division (or a dated override). If it is wrong, choose another here and tell your manager: your Entra record may need fixing (RK7).</help></label>
            <select id="fo" name="FundingOwnerId">
                <option value="">Choose…</option>
                @foreach (var o in Model.FundingOwners) { <option value="@o.Value" selected="@(o.Value == Model.FundingOwnerId?.ToString())">@o.Text</option> }
            </select>
            @if (!string.IsNullOrEmpty(Model.Basis)) { <span class="hint">From @Model.Basis.</span> }
        </div>
        <div class="field"><span class="label">&nbsp;</span><button class="btn btn-ghost" type="submit">Show services</button></div>
    </form>
</div>
@if (Model.FundingOwnerId is null)
{
    <div class="alert alert-warn">We could not work out your funding owner from your Entra record. Choose it above.</div>
}
else if (Model.Options.Count == 0)
{
    <div class="alert alert-info">@Model.FundingOwnerName has no access packages mapped yet. Its business owner maps them on the funding owner's page (activation checklist item 6).</div>
}
else
{
    <div class="table-wrap">
        <table class="stack">
            <thead>
            <tr>
                <th scope="col">Service and tier <help>One access package per LOB per tier (OD4): the package adds you to the group bound to the service's credit or spending policy.</help></th>
                <th scope="col">Funding <help>Whether @Model.FundingOwnerName has an active envelope for this service. Without one, an assignment raises a finding (N15).</help></th>
                <th scope="col">You <help>Your current assignment, read from Entra every 15 minutes.</help></th>
                <th scope="col"><span class="sr-only">Request</span></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var o in Model.Options)
            {
                <tr>
                    <td><strong>@o.ServiceName</strong><div class="small muted">@o.DisplayName · @o.Tier tier</div></td>
                    <td>@if (o.EnvelopeStatus is null) { @Ui.Pill("NO_ENVELOPE", "bad") } else { @Ui.Pill("FUNDED", "ok") if (o.EnvelopeAmount is not null) { <div class="small">@Ui.Num(o.EnvelopeAmount - o.EnvelopeCommitted) of @Ui.Num(o.EnvelopeAmount) @Units.Label(o.EnvelopeUnit ?? "") left until @Ui.Date(o.EnvelopeEnd)</div> } else { <div class="small">Funded until @Ui.Date(o.EnvelopeEnd)</div> } }</td>
                    <td>@if (o.MyAssignmentState is null) { <span class="muted">Not assigned</span> } else { @Ui.Pill(o.MyAssignmentState) <div class="small">@(o.MyAssignmentExpiresUtc is null ? "" : "until " + Ui.Date(o.MyAssignmentExpiresUtc))</div> }</td>
                    <td><a class="btn btn-small" href="@Model.MyAccessLink(o.AccessPackageId)" target="_blank" rel="noopener">Request in My Access</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<div class="card mt">
    <h2>Your access decisions <help>Decisions made in Entra, recorded here with source Entra and attributed to your funding owner.</help></h2>
    @if (Model.Decisions.Count == 0) { <p class="muted">None recorded yet. After an approver decides in My Access, it appears here within about 15 minutes.</p> }
    <ul>
        @foreach (var d in Model.Decisions) { <li>@Ui.Pill(d.Outcome) @d.ScopeText, by @d.Decider, @Ui.Local(d.DecidedAtUtc)</li> }
    </ul>
</div>
