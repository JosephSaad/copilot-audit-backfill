@model (string Target, bool ByUpn)
@{
    /* "Search everyone in Active Directory" under a person picker, always open: the list above holds only the people the
       Workbench has recorded, while this searches the whole directory Copilot Insights loads from AD and records the
       person chosen (People.cshtml.cs). Shown by workbench.js, and only to those who may record people. */
    var me = ViewContext.HttpContext.RequestServices.GetRequiredService<WebPrincipal>();
    var id = "find-" + Model.Target;
}
@if (Governance.Application.Commands.RegistryCommands.MayAddPeople(me))
{
    <div class="find-person" data-for="@Model.Target" data-by="@(Model.ByUpn ? "upn" : "id")" data-lookup="/workbench/People?handler=Find" hidden>
        <label class="small find-label" for="@id">Or search everyone in Active Directory</label>
        <help>The list above holds only the people the Workbench has recorded. This searches everyone in the directory Copilot Insights loads from Active Directory each night, by name or sign-in. The person you choose is added to the Workbench and chosen in the list, so they can be named before they ever open the Workbench.</help>
        <div class="find-box">
            <input type="search" id="@id" class="find-q" placeholder="Type two letters or more of a name or sign-in" autocomplete="off" />
            <ul class="find-results"></ul>
        </div>
        <p class="small muted find-note" role="status"></p>
    </div>
}
