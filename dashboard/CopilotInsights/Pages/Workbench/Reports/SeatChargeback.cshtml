@page "/workbench/Reports/SeatChargeback"
@model Governance.Web.Pages.Reports.SeatChargebackModel
@{
    ViewData["Title"] = "Seat chargeback";
    var rows = Model.Rows;
    var currency = rows.FirstOrDefault()?.Currency ?? Model.Settings.Currency;
}
<div class="page-head">
    <div>
        <div class="crumbs">Governance operations</div>
        <h1>Copilot seat chargeback</h1>
        <p class="lead">What each LOB is charged for Copilot seats in a month: its full reservation, plus seats assigned above it, at one rate for every LOB. The worker takes a draft after each month ends; the FinOps lead certifies it. A certified month never changes: later changes apply from their effective date. <help>Policy references: FIN-05, FIN-06, CAL-05.</help></p>
    </div>
    @if (Model.Month is not null) { <div class="page-actions"><a class="btn btn-ghost" href="@Ui.CsvHref(ViewContext.HttpContext.Request)">Export CSV</a></div> }
</div>
<div class="alert alert-info" role="note">
    <strong>Open Finance decisions.</strong> Reservations follow the April EA anniversary, while the chargeback runs by calendar year (January chargeback uses the certified December snapshot). The policy does not yet say how the two line up, for example how the remaining months are counted after an April change.
    Settings in use: increases take effect <strong>@(Model.Settings.IncreaseEffective == "NEXT_MONTH" ? "on the first day of the next month" : "on the decision date")</strong>; chargeback year <strong>@Model.Settings.ChargebackYear.ToLowerInvariant()</strong>; rate <strong>@Model.Settings.RatePerSeatMonth.ToString("N2") @Model.Settings.Currency</strong> per seat per month.
    <help>Section 6.10 parameters "applicable commitment months" and "April adjustment treatment". They are listed in Admin, Seat groups; a database administrator changes them once Finance decides. The rate is a placeholder until the contracted price is entered.</help>
</div>
<form method="get" class="btn-row mt">
    <label for="m">Month <help>Months with a snapshot. The newest is shown first.</help></label>
    <select id="m" name="month" onchange="this.form.submit()">
        @foreach (var m in Model.Months) { <option value="@m.ToString("yyyy-MM")" selected="@(Model.Month == m)">@m.ToString("MMMM yyyy")</option> }
    </select>
    <noscript><button class="btn btn-small" type="submit">Show</button></noscript>
</form>
@if (Model.Month is null)
{
    <div class="card empty mt">No snapshot yet. The worker takes the first one after the first full month of license read-back.</div>
}
else
{
    var status = rows.Any(r => r.Status == "DRAFT") ? "DRAFT" : "CERTIFIED";
    <div class="card mt">
        <div class="card-head">
            <h2>@Model.Month.Value.ToString("MMMM yyyy") @Ui.Pill(status) <help>Draft: taken by the worker and can be retaken. Certified: approved by the FinOps lead and locked.</help></h2>
            @if (Model.CanCertify && Model.HasDraft && Model.Month < new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1))
            {
                <form method="post" asp-page-handler="Certify" asp-route-month="@Model.Month.Value.ToString("yyyy-MM")" data-confirm="Certify @Model.Month.Value.ToString("MMMM yyyy")? It cannot be changed afterwards."><idem /><button class="btn btn-ok" type="submit">Certify this month</button></form>
            }
        </div>
        @{ var cert = rows.FirstOrDefault(r => r.CertifiedUtc is not null); }
        @if (cert is not null) { <p class="small muted">Certified by @cert.CertifiedByName on @Ui.Local(cert.CertifiedUtc).</p> }
        <div class="table-wrap">
            <table class="stack">
                <thead><tr>
                    <partial name="_Th" model='("", "LOB", "The line of business charged.")' />
                    <partial name="_Th" model='("", "Reserved", "The reservation in effect at month end. Charged in full (FIN-05).")' />
                    <partial name="_Th" model='("", "Assigned", "Seats people in the LOB held at month end.")' />
                    <partial name="_Th" model='("", "Over", "Assigned above the reservation. Charged on top (FIN-06).")' />
                    <partial name="_Th" model='("", "Charged seats", "Reserved plus over.")' />
                    <partial name="_Th" model='("", "Rate", "One rate per seat per month for every LOB.")' />
                    <partial name="_Th" model='("", "Amount", "Charged seats times the rate.")' />
                </tr></thead>
                <tbody>
                @foreach (var r in rows)
                {
                    <tr class="@(r.FundingOwnerId is null ? "row-warn" : "")">
                        <td data-label="LOB">@if (r.FundingOwnerId is null) { <strong>No LOB</strong> <div class="small">Seats no tracking group claims. Nobody is charged: fix the attribution.</div> } else { @r.LobName }</td>
                        <td data-label="Reserved" class="num">@Ui.Num(r.ReservedSeats)</td>
                        <td data-label="Assigned" class="num">@Ui.Num(r.AssignedSeats)</td>
                        <td data-label="Over" class="num @(r.OverSeats > 0 ? "text-bad" : "")">@Ui.Num(r.OverSeats)</td>
                        <td data-label="Charged seats" class="num">@Ui.Num(r.ChargeSeats)</td>
                        <td data-label="Rate" class="num">@r.RatePerSeat.ToString("N2")</td>
                        <td data-label="Amount" class="num"><strong>@r.Amount.ToString("N2")</strong> <span class="small muted">@r.Currency</span></td>
                    </tr>
                }
                </tbody>
                @{ var lobs = rows.Where(r => r.FundingOwnerId is not null).ToList(); }
                <tfoot>
                <tr>
                    <th scope="row">Total charged to LOBs</th>
                    <td class="num">@Ui.Num(lobs.Sum(r => r.ReservedSeats))</td>
                    <td class="num">@Ui.Num(lobs.Sum(r => r.AssignedSeats))</td>
                    <td class="num">@Ui.Num(lobs.Sum(r => r.OverSeats))</td>
                    <td class="num">@Ui.Num(lobs.Sum(r => r.ChargeSeats))</td>
                    <td></td>
                    <td class="num"><strong>@lobs.Sum(r => r.Amount).ToString("N2")</strong> <span class="small muted">@currency</span></td>
                </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
