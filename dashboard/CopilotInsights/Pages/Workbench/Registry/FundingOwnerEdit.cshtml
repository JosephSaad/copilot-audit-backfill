@page "/workbench/Registry/FundingOwners/Edit/{id:guid?}"
@model Governance.Web.Pages.Registry.FundingOwnerEditModel
@{
    ViewData["Title"] = Model.SeatsOnly ? (Model.Id is null ? "Add a line of business" : "Edit line of business") : Model.Id is null ? "Add a funding owner" : "Edit funding owner";
}
<div class="page-head">
    <div>
        <div class="crumbs"><a href="/workbench/Registry/FundingOwners">@(Model.SeatsOnly ? "Lines of business" : "Funding owners")</a></div>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">@(Model.SeatsOnly ? "A line of business is active once it is saved. Give it its AD tracking group on Seat groups next." : "A new funding owner starts in Draft. Naming the business owner gives them the role and asks them to accept it.")</p>
    </div>
</div>
<form method="post" class="card">
    <idem />
    <input type="hidden" asp-for="Input.RowVer" />
    <div class="form-grid">
        <div class="field"><label asp-for="Input.Code" class="req">Code <help>Short and stable, for example RETAIL. Used in reports and access package names.</help></label><input asp-for="Input.Code" maxlength="32" required /></div>
        <div class="field"><label asp-for="Input.Name" class="req">Name <help>The name people will see.</help></label><input asp-for="Input.Name" maxlength="200" required /></div>
        @if (Model.SeatsOnly)
        {
            /* Copilot seats only: the finance fields are kept as they are, not shown. */
            <input type="hidden" asp-for="Input.OwnerType" /><input type="hidden" asp-for="Input.FinancePartnerPersonId" />
            <input type="hidden" asp-for="Input.FinanceNode" /><input type="hidden" asp-for="Input.IsCriticalShared" />
        }
        else
        {
        <div class="field"><label asp-for="Input.OwnerType">Type <help>LOB: a division with its own budget authority. Enterprise Shared: centrally funded and used across LOBs, with a shared-service owner.</help></label>
            <select asp-for="Input.OwnerType"><option value="LOB">Line of business</option><option value="ENTERPRISE_SHARED">Enterprise Shared</option></select></div>
        }
        <div class="field"><label asp-for="Input.ParentFundingOwnerId">Part of <help>Optional, for roll-ups.</help></label>
            <select asp-for="Input.ParentFundingOwnerId"><option value="">None</option>@foreach (var o in Model.Owners) { <option value="@o.Value" selected="@(o.Value == Model.Input.ParentFundingOwnerId?.ToString())">@o.Text</option> }</select></div>
        <div class="field"><label asp-for="Input.BusinessOwnerPersonId">Business owner <help>One person: business case, funding, overage, continuity, recertification and retirement decisions.</help></label>
            <select asp-for="Input.BusinessOwnerPersonId"><option value="">Not named yet</option>@foreach (var o in Model.People) { <option value="@o.Value" selected="@(o.Value == Model.Input.BusinessOwnerPersonId?.ToString())">@o.Text</option> }</select><partial name="_FindPerson" model='("Input_BusinessOwnerPersonId", false)' /></div>
        @if (!Model.SeatsOnly)
        {
        <div class="field"><label asp-for="Input.FinancePartnerPersonId">Finance partner <help>Consulted on envelopes and showback.</help></label>
            <select asp-for="Input.FinancePartnerPersonId"><option value="">None</option>@foreach (var o in Model.People) { <option value="@o.Value" selected="@(o.Value == Model.Input.FinancePartnerPersonId?.ToString())">@o.Text</option> }</select><partial name="_FindPerson" model='("Input_FinancePartnerPersonId", false)' /></div>
        <div class="field"><label asp-for="Input.FinanceNode">Finance hierarchy node <help>From the Finance cost-center hierarchy.</help></label><input asp-for="Input.FinanceNode" maxlength="100" /></div>
        }
        <div class="field"><label asp-for="Input.EffectiveFrom">Effective from <help>The first day this applies. History is kept, so earlier days still show the earlier value.</help></label><input asp-for="Input.EffectiveFrom" type="date" /></div>
        @if (!Model.SeatsOnly)
        {
        <div class="field full"><label class="check"><input type="checkbox" asp-for="Input.IsCriticalShared" /> Critical shared service <help>Its funding must not depend on discretionary LOB envelopes (F9); continuity acceptance applies at production (D5).</help></label></div>
        }
    </div>
    <button class="btn mt" type="submit">Save</button>
</form>
