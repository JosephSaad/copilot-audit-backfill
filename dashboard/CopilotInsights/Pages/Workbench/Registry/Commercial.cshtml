@page "/workbench/Registry/Commercial"
@model Governance.Web.Pages.Registry.CommercialModel
@{
    ViewData["Title"] = "Commercial inventory";
    var e = Model.Editing;
}
<div class="page-head">
    <div>
        <div class="crumbs">Registry</div>
        <h1>Commercial inventory</h1>
        <p class="lead">Licenses, monthly packs, P3 plans and pay-as-you-go scopes, with renewal dates and who holds purchase authority. Credits, P3 commit units and currency are kept apart. A P3 plan is shared at its billing scope: no agent owns a balance. <help>Process references: A4; C05, C19.</help></p>
    </div>
</div>
<partial name="_Search" model="Model.Search" />
<div class="table-wrap">
    <table class="stack">
        <thead>
        <tr>
            <partial name="_Th" model='("name", "Item", "What was bought or set up.")' />
            <partial name="_Th" model='("type", "Type", "License, pack, P3 plan or PAYG scope.")' />
            <partial name="_Th" model='("", "Quantity", "In its own unit.")' />
            <partial name="_Th" model='("end", "Term", "Start and end of the term.")' />
            <partial name="_Th" model='("renewal", "Renewal", "Renewal date and whether it renews by itself (C06).")' />
            <partial name="_Th" model='("", "Purchase authority", "Who approves purchases and renewals for this item.")' />
            <partial name="_Th" model='("", "Contract", "Reconciled to the contract (setup step 4).")' />
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items.Items)
        {
            <tr>
                <td>@if (Model.CanEdit) { <a href="/workbench/Registry/Commercial?edit=@c.PublicId"><strong>@c.Name</strong></a> } else { <strong>@c.Name</strong> }<div class="small muted">@c.BillingScope</div></td>
                <td>@Ui.Words(c.ItemType)</td>
                <td class="num">@Ui.Num(c.Quantity) <span class="small muted">@(c.Unit is null ? "" : Units.Label(c.Unit))</span></td>
                <td class="small">@Ui.Date(c.StartOn) to @Ui.Date(c.EndOn)</td>
                <td class="small">@Ui.Date(c.RenewalOn)@(c.AutoRenew ? " (auto-renews)" : "")</td>
                <td>@(c.PurchaseAuthorityName ?? "Not named")</td>
                <td>@(c.ReconciledToContract ? Ui.Pill("RECONCILED", "ok") : Ui.Pill("NOT_RECONCILED", "warn"))<div class="small muted">@c.ContractRef</div></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Items.Query.Page, Model.Items.Pages, Model.Items.Total)" />
@if (Model.CanEdit)
{
    <form method="post" asp-page-handler="Save" class="card mt">
        <idem />
        @if (e is not null) { <input type="hidden" name="id" value="@e.PublicId" /><input type="hidden" name="rowVer" value="@(e.RowVer is null ? "" : Convert.ToBase64String(e.RowVer))" /> }
        <h2>@(e is null ? "Add an item" : "Edit " + e.Name)</h2>
        <div class="form-grid">
            <div class="field"><label for="ct">Type <help>License, monthly pack, P3 pre-purchase plan or PAYG billing scope.</help></label><select id="ct" name="itemType">@foreach (var t in new[] { "LICENSE", "PACK", "P3", "PAYG_SCOPE" }) { <option value="@t" selected="@(e?.ItemType == t)">@(t == "LICENSE" ? "License" : Ui.Words(t))</option> }</select></div>
            <div class="field"><label for="cn" class="req">Name <help>How Finance and Sourcing call this item.</help></label><input id="cn" name="name" value="@e?.Name" required maxlength="200" /></div>
            <div class="field"><label for="cq">Quantity <help>How much was bought, in the unit next to it.</help></label><input id="cq" type="number" name="quantity" value="@e?.Quantity" min="0" step="1" /></div>
            <div class="field"><label for="cu">Unit <help>Credits, P3 commit units, seats or currency are kept apart and never converted without a dated rate.</help></label><select id="cu" name="unit"><option value="">None</option>@foreach (var u in new[] { "COPILOT_CREDIT", "P3_COMMIT_UNIT", "SEAT", "USD", "CAD" }) { <option value="@u" selected="@(e?.Unit == u)">@Units.Label(u)</option> }</select></div>
            <div class="field"><label for="cs">Start <help>When the commitment starts.</help></label><input id="cs" type="date" name="startOn" value="@e?.StartOn?.ToString("yyyy-MM-dd")" /></div>
            <div class="field"><label for="ce">End <help>When it ends.</help></label><input id="ce" type="date" name="endOn" value="@e?.EndOn?.ToString("yyyy-MM-dd")" /></div>
            <div class="field"><label for="cr">Renewal <help>When it renews; notices go out 90, 60 and 30 days before (N18).</help></label><input id="cr" type="date" name="renewalOn" value="@e?.RenewalOn?.ToString("yyyy-MM-dd")" /></div>
            <div class="field"><label for="cb">Billing scope <help>Subscription, billing policy or tenant.</help></label><input id="cb" name="billingScope" value="@e?.BillingScope" maxlength="400" /></div>
            <div class="field"><label for="cc">Contract reference <help>The contract or order number, so Finance can reconcile it.</help></label><input id="cc" name="contractRef" value="@e?.ContractRef" maxlength="200" /></div>
            <div class="field"><label for="cp">Purchase authority <help>The person who approves purchases and renewals of this item (Commercial Authority).</help></label><select id="cp" name="purchaseAuthorityPersonId"><option value="">None</option>@foreach (var p in Model.People) { <option value="@p.Value" selected="@(p.Value == e?.PurchaseAuthorityPersonId?.ToString())">@p.Text</option> }</select></div>
            <div class="field full checks"><label class="check"><input type="checkbox" name="autoRenew" value="true" checked="@(e?.AutoRenew == true)" /> Renews automatically</label><label class="check"><input type="checkbox" name="reconciled" value="true" checked="@(e?.ReconciledToContract == true)" /> Reconciled to the contract</label></div>
            <div class="field full"><label for="cnt">Notes <help>Anything Finance or Sourcing should know.</help></label><textarea id="cnt" name="notes" maxlength="2000">@e?.Notes</textarea></div>
        </div>
        <button class="btn mt" type="submit">Save</button>
    </form>
}
