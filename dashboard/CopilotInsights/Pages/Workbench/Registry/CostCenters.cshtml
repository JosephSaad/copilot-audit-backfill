@page "/workbench/Registry/CostCenters"
@model Governance.Web.Pages.Registry.CostCentersModel
@{
    ViewData["Title"] = "Cost centers";
}
<div class="page-head">
    <div>
        <div class="crumbs">Ownership registry</div>
        <h1>Cost centers</h1>
        <p class="lead">Finance accounting units used for showback, each belonging to one funding owner at a time. Moving a cost center is versioned, so reports for past dates still show who owned it then. Finance validates each one. <help>Process references: H3.</help></p>
    </div>
</div>
<partial name="_Search" model="Model.Search" />
<div class="table-wrap">
    <table class="stack">
        <thead>
        <tr>
            <partial name="_Th" model='("code", "Code", "The Finance cost-center code, as it appears in Entra employeeOrgData.costCenter.")' />
            <partial name="_Th" model='("name", "Name", "Finance name.")' />
            <partial name="_Th" model='("owner", "Funding owner", "The LOB or Enterprise Shared unit it belongs to today.")' />
            <partial name="_Th" model='("validated", "Finance validated", "Activation checklist item 3: Finance confirms the mapping.")' />
            <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items.Items)
        {
            <tr>
                <td><strong>@c.Code</strong></td>
                <td>@c.Name<div class="small muted">@c.FinanceNode</div></td>
                <td>@c.FundingOwnerName</td>
                <td>@(c.ValidatedByFinance ? Ui.Pill("VALIDATED", "ok") : Ui.Pill("NOT_VALIDATED", "warn"))</td>
                <td>@if (Model.IsFinance) { <form method="post" asp-page-handler="Validate" asp-route-id="@c.PublicId" asp-route-valid="@(!c.ValidatedByFinance)"><idem /><button class="btn btn-small btn-ghost" type="submit">@(c.ValidatedByFinance ? "Unvalidate" : "Validate")</button></form> }</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Items.Query.Page, Model.Items.Pages, Model.Items.Total)" />
@if (Model.CanEdit)
{
    <div class="grid grid-2 mt">
        <form method="post" asp-page-handler="Save" class="card">
            <idem />
            <h2>Add a cost center</h2>
            <div class="form-grid">
                <div class="field"><label for="cc" class="req">Code <help>The cost center code as Finance uses it, and as it appears in Entra (employeeOrgData).</help></label><input id="cc" name="code" required maxlength="100" /></div>
                <div class="field"><label for="cn" class="req">Name <help>The cost center's name.</help></label><input id="cn" name="name" required maxlength="200" /></div>
                <div class="field"><label for="cf">Finance node <help>Where it sits in the Finance hierarchy.</help></label><input id="cf" name="financeNode" maxlength="100" /></div>
                <div class="field"><label for="co" class="req">Funding owner <help>The LOB or Enterprise Shared unit that owns this cost center from now on.</help></label><select id="co" name="fundingOwnerId" required>@foreach (var o in Model.Owners) { <option value="@o.Value">@o.Text</option> }</select></div>
            </div>
            <button class="btn btn-ghost mt" type="submit">Add</button>
        </form>
        @if (Model.IsFinance)
        {
            <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="card">
                <idem />
                <h2>Import from Finance <help>A CSV with the columns Code, Name, FinanceNode, FundingOwnerCode. Existing codes are updated, new ones added; imported rows count as validated by Finance.</help></h2>
                <div class="field"><label for="cv">CSV file <help>A Finance export with columns Code, Name, FinanceNode, FundingOwnerCode.</help></label><input id="cv" type="file" name="file" accept=".csv" required /></div>
                <button class="btn btn-ghost mt" type="submit">Import</button>
            </form>
        }
    </div>
}
