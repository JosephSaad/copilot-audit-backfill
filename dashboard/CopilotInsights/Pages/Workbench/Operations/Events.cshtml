@page "/workbench/Operations/Events"
@model Governance.Web.Pages.Operations.EventsModel
@{
    ViewData["Title"] = "Consumption events";
}
<div class="page-head">
    <div>
        <div class="crumbs">Governance operations</div>
        <h1>Consumption events</h1>
        <p class="lead">Threshold notices, denials, exhaustion and runaway activity. Acknowledge within the target for the severity, act within your authority, restore, then record the review. High and critical events have a linked ITSM incident. <help>Process references: G1 to G5.</help></p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost" href="/workbench/Operations/Events?open=@(!Model.Open)">@(Model.Open ? "Show closed too" : "Open only")</a>
        <a class="btn" href="/workbench/Events/Report">Report an event</a>
    </div>
</div>
<partial name="_Search" model="Model.Search" />
<div class="table-wrap">
    <table class="stack">
        <thead>
        <tr>
            <partial name="_Th" model='("severity", "Event", "Severity and what happened.")' />
            <partial name="_Th" model='("", "Funding owner, workload", "Who is affected.")' />
            <partial name="_Th" model='("reported", "Reported", "When and by whom.")' />
            <partial name="_Th" model='("due", "Acknowledge by", "Critical: 1 hour around the clock; high: 4 hours; normal: 1 business day.")' />
            <partial name="_Th" model='("status", "Status", "Open, acknowledged, restored or closed.")' />
            <partial name="_Th" model='("", "Incident", "The linked ITSM incident for high and critical events.")' />
        </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Items.Items)
        {
            var late = e.AckUtc is null && e.AckDueUtc < DateTime.UtcNow;
            <tr>
                <td>@Ui.Pill(e.Severity) <a href="/workbench/Operations/Events/@e.PublicId"><strong>@e.Title</strong></a><div class="small muted">@Ui.Words(e.EventClass)@(e.CriticalServiceAffected ? " · critical service" : "")</div></td>
                <td>@e.FundingOwnerName<div class="small muted">@e.WorkloadName</div></td>
                <td class="small">@Ui.Local(e.ReportedUtc)<div>@e.ReportedByName</div></td>
                <td class="small">@Ui.Local(e.AckDueUtc) @if (late) { @Ui.Pill("OVERDUE", "bad") }</td>
                <td>@Ui.Pill(e.Status)</td>
                <td>@(e.IncidentNumber ?? (e.Severity == "NORMAL" ? "—" : "being created"))</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Items.Query.Page, Model.Items.Pages, Model.Items.Total)" />
