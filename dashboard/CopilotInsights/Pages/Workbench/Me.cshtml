@page "/workbench/Me"
@model MeModel
@{
    ViewData["Title"] = "Your roles";
    var p = Model.Principal;
}
<div class="page-head">
    <div>
        <h1>Your roles</h1>
        <p class="lead">What the Workbench lets you do and where. Roles for a line of business are given by its business owner; central roles by the Platform Owner. Every role is reviewed each year.</p>
    </div>
</div>
<div class="grid grid-2">
    <div class="card">
        <h2>You</h2>
        <dl class="facts">
            <dt>Name <help>Your name from Microsoft Entra ID.</help></dt><dd>@p.DisplayName</dd>
            <dt>Sign-in <help>Your user principal name.</help></dt><dd>@p.Upn</dd>
            <dt>Access <help>Coarse access from your Entra app roles: which parts of the Workbench you can open.</help></dt><dd>@string.Join(", ", p.AppRoles.OrderBy(x => x))</dd>
            <dt>Central view <help>Central roles see every funding owner. Others see only the funding owners where they hold a role or a delegation.</help></dt><dd>@(p.IsCentral ? "Yes" : "No")</dd>
        </dl>
    </div>
    <div class="card">
        <h2>Roles held today</h2>
        @if (p.RoleLabels.Count == 0)
        {
            <p class="muted">No roles yet. You can still submit requests and use approved services.</p>
        }
        else
        {
            <ul>
                @foreach (var r in p.RoleLabels)
                {
                    <li>@r.Name@(r.Scope is null ? " (all funding owners)" : $" for {r.Scope}")</li>
                }
            </ul>
        }
    </div>
</div>
