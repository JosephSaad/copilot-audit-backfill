@page "/workbench/Error"
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="card">
    <h1>Something went wrong</h1>
    <p>The page could not be shown. Nothing was changed if an action did not finish. If it happens again, quote this reference to the Workbench team: <strong class="mono">@Model.Reference</strong>.</p>
    <p><a class="btn" href="/workbench/Start">Back to Start</a></p>
</div>
