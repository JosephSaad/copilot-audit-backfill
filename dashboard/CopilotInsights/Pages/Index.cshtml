@page "/"
@model IndexModel
<div class="page-head">
    <div class="eyebrow">Microsoft 365 Copilot usage</div>
    <h1>Copilot Insights</h1>
    <p class="intro">How your organisation uses Copilot, from the audit log, with licences from Microsoft Graph and the organisation from Active Directory. Pick the view that matches your role; every page shows only what you may see.</p>
</div>

@if (Model.Denied is null)
{
    <div class="notice"><b>Your access.</b> @Model.AccessSummary
        @if (Model.Viewer.Roles.Count > 0)
        {
            <span> Roles: @string.Join(", ", Model.Viewer.Roles.OrderBy(r => r)).</span>
        }
    </div>
    @if (Model.Viewer.IsAdmin && Model.OrgTop is null)
    {
        <div class="denied"><b>Set the top of the organisation.</b> Nobody sees the whole organisation by level until the CEO's UPN is set in <a href="/admin/access">Admin › Access</a>. Until then only people granted Organization do.</div>
    }
    <div class="cards">
        @foreach (var g in Nav.For(Model.Viewer))
        {
            <div class="card">
                <h3 class="cat">@g.Persona</h3>
                <p>@g.Who</p>
                <ul>
                    @foreach (var p in g.Pages)
                    {
                        <li><a href="@p.Path">@p.Title</a></li>
                    }
                </ul>
            </div>
        }
    </div>
}
else
{
    <div class="denied">@Model.Denied</div>
}
