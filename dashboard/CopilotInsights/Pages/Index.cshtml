@page "/"
@model IndexModel
@inject CopilotInsights.Infrastructure.TenantAccessor Tenants
<div class="page-head">
    <div class="eyebrow">Microsoft 365 Copilot usage</div>
    <h1>Copilot Insights</h1>
    <p class="intro">How your organization uses Copilot, from the audit log, with licenses from Microsoft Graph and the organization from Active Directory. Pick the view that matches your role; every page shows only what you may see.</p>
</div>

@if (Model.Denied is null)
{
    <div class="notice"><b>Your access.</b> @Model.AccessSummary
        @if (Model.Viewer.Roles.Count > 0)
        {
            <span> Roles: @string.Join(", ", Model.Viewer.Roles.OrderBy(r => r)).</span>
        }
    </div>
    @if (Model.Viewer.IsAdmin && Model.OrgTop is null)
    {
        <div class="denied"><b>Set the top of the organization.</b> Nobody sees the whole organization by level until the CEO's UPN is set in <a href="/admin/access">Admin › Access</a>. Until then only people granted Organization do.</div>
    }
    var groups = Nav.For(Model.Viewer, Model.PrivacyMode, Tenants.Many, Model.HiddenReports);
    var mine = CopilotInsights.Infrastructure.MostUsed.Pick(Model.MostUsedPaths, groups);
    <div class="cards">
        @if (mine.Count > 0)
        {
            <div class="card mine">
                <h3 class="cat">Your most used</h3>
                <p>The reports you opened most in the last @CopilotInsights.Infrastructure.MostUsed.Days days</p>
                <ul>
                    @foreach (var p in mine)
                    {
                        <li><a href="@p.Path"><span class="rt"><b>@p.Title</b><small>@NavText.What(p)</small></span></a></li>
                    }
                </ul>
            </div>
        }
        @foreach (var g in groups)
        {
            <div class="card">
                <h3 class="cat">@g.Persona</h3>
                <p>@g.Who</p>
                @foreach (var sub in NavText.Sub(g.Pages))
                {
                    @if (sub.Heading is not null) { <h4>@sub.Heading</h4> }
                    <ul>
                        @foreach (var p in sub.Pages)
                        {
                            <li><a href="@p.Path"><span class="rt"><b>@p.Title</b><small>@NavText.What(p)</small></span></a></li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
}
else
{
    <div class="denied">@Model.Denied</div>
}
