@page "/"
@model IndexModel
@inject CopilotInsights.Infrastructure.TenantAccessor Tenants
<div class="page-head">
    <div class="eyebrow">AI use, cost and control</div>
    <h1>Copilot Insights</h1>
    <p class="intro">Choose an area to see its reports, or type a report's name in <i>Find a report</i> on the left.</p>
</div>

@if (Model.Denied is null)
{
    @* One line on access and how current the data is; the roles behind "More". *@
    <details class="notice access">
        <summary><b>Your access.</b> @Model.AccessSummary @(Model.Freshness is null ? "" : " " + Model.Freshness) <span class="more">More</span></summary>
        @if (Model.Viewer.SeesAny)
        {
            <p>Sections granted to you: @CopilotInsights.Infrastructure.Sections.Names(Model.Viewer.SectionKeys.OrderBy(k => CopilotInsights.Infrastructure.Sections.Keys.ToList().IndexOf(k))).
                Each section is granted in Admin › Access; a section not granted is not in your menu.</p>
        }
        @{ var shownRoles = Model.Viewer.Roles.Where(r => r != CopilotInsights.Infrastructure.Roles.Sections).OrderBy(r => r).ToList(); }
        @if (shownRoles.Count > 0)
        {
            <p>Your roles: @string.Join(", ", shownRoles). A section's role opens its reports that name people.</p>
        }
        <p>Every report shows only the people you may see.</p>
    </details>
    @if (Model.NoAccess)
    {
        <div class="denied"><b>No access yet.</b> No section of the dashboard is granted to you. An administrator grants sections in Admin › Access.
            @if (Model.Administrators.Count > 0)
            {
                <p>The dashboard's administrators: @string.Join(", ", Model.Administrators).</p>
            }
        </div>
    }
    @if (Model.Viewer.IsAdmin && Model.OrgTop is null)
    {
        <div class="denied"><b>Set the top of the organization.</b> Nobody sees the whole organization by level until the CEO's sign-in (UPN) is set in <a href="/admin/access">Admin › Access</a>. Until then only people granted Organization do.</div>
    }
    var groups = Nav.For(Model.Viewer, Model.PrivacyMode, Tenants.Many, Model.HiddenReports);
    @* Money found: saved to date and the high-confidence savings found a month, each opening Costs and savings, which
       shows the same figure. Only for those the page is for, and only once the ledger holds something. *@
    @if (Model.Ledger is { Any: true } led && groups.Any(g => g.Pages.Any(p => p.Path == "/leadership/costs")))
    {
        <p class="notice ledger"><span><b>Money found.</b>
            @if (led.SavedToDate > 0) { <a href="/leadership/costs">@CopilotInsights.Data.CostRules.Money(Math.Round(led.SavedToDate, 0), led.Currency) saved to date</a><text> through this dashboard</text> } else { <text>Nothing saved through this dashboard yet</text> }@if (led.FoundHigh > 0) { <text>, and </text><a href="/leadership/costs?conf=High#savings">@CopilotInsights.Data.CostRules.Money(Math.Round(led.FoundHigh, 0), led.Currency) a month more found</a><text> with high confidence.</text> } else { <text>.</text> }
            <span class="sub">Saved: Copilot licenses taken back after this dashboard named them, each month they stay gone. Found: the savings Costs and savings finds today.</span></span></p>
    }
    @* The three questions the dashboard answers, each with one figure that opens the page showing the same number. *@
    @if (Model.Questions.Count > 0)
    {
        <section class="questions" aria-label="The three questions">
            @foreach (var q in Model.Questions)
            {
                <div class="qcard">
                    <h2>@q.Ask</h2>
                    @if (q.Figure is not null)
                    {
                        @if (q.Href is not null) { <a class="qfig" href="@q.Href">@q.Figure</a> } else { <span class="qfig">@q.Figure</span> }
                    }
                    <p>@q.Line</p>
                    <ul>@foreach (var (text, href) in q.Links) { <li><a href="@href">@text</a></li> }</ul>
                </div>
            }
        </section>
    }
    var mine = CopilotInsights.Infrastructure.MostUsed.Pick(Model.MostUsedPaths, groups);
    @* The reports this person opens most, as a row of shortcuts rather than a card of their own. *@
    @if (mine.Count > 0)
    {
        <section class="jump" aria-label="Your most used">
            <h2>Your most used</h2>
            <div class="chips">
                @foreach (var p in mine.Take(6))
                {
                    <a class="chip" href="@p.Path" title="@NavText.What(p)">@p.Title</a>
                }
            </div>
        </section>
    }
    @* One large card for each area, its reports behind it: selecting a card opens them, under their headings,
       each with what it answers, as "About these reports" does. Without script a card opens the area's first report. *@
    <div class="hgrid">
        @foreach (var g in groups)
        {
            var id = "home-" + g.Persona.ToLowerInvariant().Replace(' ', '-');
            var first = g.Pages[0];
            <div class="hcard">
                <a class="hopen" href="@first.Path" data-dialog="@id" aria-haspopup="dialog">
                    <span class="hname">@g.Persona</span>
                    <span class="hwho">@g.Who</span>
                    <span class="hcount">@g.Pages.Count report@(g.Pages.Count == 1 ? "" : "s") ›</span>
                </a>
                <a class="hstart" href="@first.Path">Start with: <b>@first.Title</b></a>
            </div>
            <dialog class="hdialog" id="@id" aria-label="@g.Persona reports">
                <div class="phead"><h2>@g.Persona</h2><p>@g.Who</p><button type="button" class="pclose" aria-label="Close">×</button></div>
                @foreach (var sub in NavText.Sub(g.Pages))
                {
                    @if (sub.Heading is not null) { <h3>@sub.Heading</h3> }
                    <ul>
                        @foreach (var p in sub.Pages)
                        {
                            <li><a href="@p.Path"><span class="rt"><b>@p.Title</b><small>@NavText.What(p)</small>@if (p.Role is not null) { <em>names people</em> }</span></a></li>
                        }
                    </ul>
                }
            </dialog>
        }
    </div>
}
else
{
    <div class="denied"><b>Not available to you.</b> @Model.Denied
        @if (Model.Administrators.Count > 0)
        {
            <p>The dashboard's administrators: @string.Join(", ", Model.Administrators).</p>
        }
        @if (Model.RequestAccess.Count > 0)
        {
            <p>Ask for it: @foreach (var (name, url) in Model.RequestAccess) { <a class="btn" href="@url" rel="noopener noreferrer" target="_blank">Request @name</a> }</p>
        }
    </div>
}
