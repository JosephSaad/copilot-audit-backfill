@inject CopilotInsights.Infrastructure.TenantAccessor Tenants
@inject global::Governance.Web.Infrastructure.WorkbenchState Workbench
@inject global::Governance.Web.Infrastructure.WebPrincipal WorkbenchMe
@inject global::Governance.Web.Infrastructure.TestingOptions WorkbenchTesting
@{
    var page = Model as InsightsPage;
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    if (path == "") path = "/";
    /* A Workbench page (Pages/Workbench) is not an InsightsPage: the same header, menu and look, with its own body. */
    var wb = global::Governance.Web.Infrastructure.WorkbenchSetup.IsWorkbenchPath(Context.Request.Path);
    var viewer = page?.Viewer ?? (wb && Context.User.Identity?.IsAuthenticated == true
        ? await Context.RequestServices.GetRequiredService<CopilotInsights.Infrastructure.ViewerService>().GetAsync() : null);
    string Href(NavPage p) => page?.Ctx is null || p.Admin || global::Governance.Web.Infrastructure.WorkbenchSetup.IsWorkbenchPath(p.Path) ? p.Path : page.Ctx.Url(p.Path);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@InsightsPage.BrowserTitle(page?.Title ?? ViewData["Title"] as string)</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
    @if (wb) { <link rel="stylesheet" href="~/workbench.css" asp-append-version="true" /> }
    <script src="~/theme.js" asp-append-version="true"></script>
</head>
<body>
@* The first thing the Tab key reaches. With a keyboard or a screen reader the page was a hundred links away,
   past the whole list of reports, on every page. *@
<a class="skip" href="#main">Skip to the page</a>
<header class="top">
    <a class="brand" href="/">Copilot Insights</a>
    @if (viewer is not null)
    {
        <div class="who">
            <span>@viewer.Name</span>
            @if (Tenants.Many)
            {
                <select class="tenant" aria-label="Tenant" data-navigate>
                    @foreach (var t in Tenants.All)
                    {
                        <option value="@(Context.Request.PathBase)@(path)?tenant=@Uri.EscapeDataString(t.Name)" selected="@(t.Name == Tenants.Current.Name)">@t.Name</option>
                    }
                </select>
            }
            <span class="scope-pill">@(!viewer.Admitted ? (viewer.AnyAdmin ? "Admin pages only" : "No access") : viewer.OrgWide ? "Whole organization" : viewer.InDirectory ? (viewer.PeopleBelow > 0 ? $"You and {viewer.PeopleBelow:#,0} people under you" : "Your own use") : "Not in the directory")</span>
            <button type="button" class="theme" id="theme-toggle" aria-label="Switch between light and dark theme">◐</button>
            @if (viewer.SignedInWith == CopilotInsights.Infrastructure.SignIn.Entra)
            {
                <a class="signout" href="/signout">Sign out</a>
            }
        </div>
    }
</header>
<div class="shell">
    @* Sections fold, with the one you are in open to begin with: selecting a section opens it or folds it, and
       moves nothing else. "About these reports", under an open section's links, opens a panel of them under their headings,
       each with what it answers; the box at the top finds a report. Without script every section is open. *@
    <nav class="side" aria-label="Reports">
        <a class="home @(path == "/" ? "on" : "")" href="/?home=1">Start</a>
        @* Success stories: open to everyone the dashboard lets in, so not in a section. *@
        @if (viewer is not null && viewer.Admitted)
        {
            <a class="home @(path == "/stories" ? "on" : "")" href="/stories">Success stories</a>
        }
        @{ var groups = Nav.For(viewer, page?.PrivacyMode ?? false, Tenants.Many, page?.HiddenReports).Concat(await global::Governance.Web.Infrastructure.WorkbenchNav.ForAsync(Context, WorkbenchMe, Workbench.On)).ToList(); }
        @if (groups.Count > 0)
        {
            <input type="search" class="find" id="nav-find" placeholder="Find a report (press /)" aria-label="Find a report" aria-keyshortcuts="/" autocomplete="off" spellcheck="false" />
            <p class="none" id="nav-none" hidden>No report matches. Try a word from what it shows, such as "unused" or "training".</p>
            <p class="none" id="nav-count" role="status" hidden></p>
            @* On a narrow window (a phone, a tablet upright) the list is above the page, and would fill the first screen:
               there it folds behind one button that says where you are. Finding still shows its matches. *@
            var at = groups.SelectMany(g => g.Pages.Select(p => (g, p))).FirstOrDefault(x => x.p.Path == path);
            <button type="button" class="navtog" aria-expanded="false" aria-controls="nav-sections"
                    aria-label="Show or hide the list of reports">@(at.p is null ? "All reports" : $"{at.g.Persona} › {at.p.Title}")</button>
        }
        <div id="nav-sections">
        @{ var mine = CopilotInsights.Infrastructure.MostUsed.Pick(page?.MostUsedPaths ?? [], groups); }
        @if (mine.Count > 0)
        {
            @* The reports this person opens most: a section like the others, open on the start page. *@
            <div class="grp mine" data-grp="Your most used">
                <button type="button" class="gname" aria-expanded="false" aria-controls="nav-mine-links"><span>Your most used</span><span class="n">@mine.Count</span></button>
                <div class="glinks" id="nav-mine-links">
                    @foreach (var p in mine)
                    {
                        var href = Href(p);
                        <a class="@(path == p.Path ? "on" : "")" href="@href" data-what="@NavText.Tip(p)" aria-description="@NavText.Tip(p)">@p.Title</a>
                    }
                </div>
            </div>
        }
        @foreach (var g in groups)
        {
            var here = g.Pages.Any(p => p.Path == path);
            var id = "nav-" + g.Persona.ToLowerInvariant().Replace(' ', '-');
            <div class="grp @(here ? "here open" : "")" data-grp="@g.Persona" data-who="@g.Who">
                <button type="button" class="gname" aria-expanded="@(here ? "true" : "false")" aria-controls="@(id)-links"><span>@g.Persona</span><span class="n">@g.Pages.Count</span></button>
                <div class="glinks" id="@(id)-links">
                    @foreach (var p in g.Pages)
                    {
                        var href = Href(p);
                        <a class="@(path == p.Path ? "on" : "")" href="@href" data-what="@NavText.Tip(p)" aria-description="@NavText.Tip(p)">@p.Title@if (CopilotInsights.Pages.HiddenReports.Is(page?.BetaReports, CopilotInsights.Pages.Nav.Key(g, p))) { <span class="beta">Beta</span> }</a>
                    }
                    <button type="button" class="gabout" aria-haspopup="dialog" aria-expanded="false" aria-controls="@(id)-panel">About these reports</button>
                </div>
                <div class="gpanel" id="@(id)-panel" role="dialog" aria-label="@g.Persona reports" hidden>
                    <div class="phead"><h2>@g.Persona</h2><p>@g.Who</p><button type="button" class="pclose" aria-label="Close">×</button></div>
                    @foreach (var sub in NavText.Sub(g.Pages))
                    {
                        @if (sub.Heading is not null) { <h3>@sub.Heading</h3> }
                        <ul>
                            @foreach (var p in sub.Pages)
                            {
                                var href = Href(p);
                                <li><a class="@(path == p.Path ? "on" : "")" href="@href"><span class="rt"><b>@p.Title</b><small>@NavText.What(p)</small>@if (p.Role is not null) { <em>names people</em> }</span></a></li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
        </div>
    </nav>
    <main id="main" tabindex="-1">
        @if (wb)
        {
            @* The Workbench's pages: who is acting (Development "act as"), what the last action did, then the page. *@
            <div class="wb">
                @if (WorkbenchMe.ActingAs)
                {
                    <div class="actas-banner" role="status">
                        <span>Test mode: acting as <strong>@WorkbenchMe.DisplayName</strong> (signed in as @WorkbenchMe.RealDisplayName). Every action is recorded with both names.</span>
                        <form method="post" asp-page="/Workbench/ActAs" asp-page-handler="Stop" class="inline"><input type="hidden" name="__idem" value="@Guid.NewGuid()" /><button class="btn btn-small btn-light" type="submit">Stop acting</button></form>
                    </div>
                }
                else if (WorkbenchTesting.AllowActAs && WorkbenchMe.CanActAs)
                {
                    <p class="actas-offer"><a href="/workbench/ActAs">Act as a test persona</a></p>
                }
                @if (TempData["Flash"] is string ok)
                {
                    <div class="alert alert-ok" role="status"><span aria-hidden="true">✓</span> <span class="sr-only">Success:</span> @ok</div>
                }
                @if (TempData["FlashError"] is string err)
                {
                    <div class="alert alert-bad" role="alert"><strong>Not done.</strong> @err</div>
                }
                @RenderBody()
            </div>
        }
        else
        {
            @RenderBody()
        }
        @{
            /* 2.4.10: the report before this one in its section and the one after, at the foot of the page, among those
               this person can open. By the end of a report the list is a long way up, and on a phone it is folded away. */
            var (before, after, sect) = Nav.Beside(groups, path);
        }
        @if (sect is not null && (page is { Denied: null } || wb) && (before ?? after) is not null)
        {
            <nav class="pager" aria-label="More in @sect.Persona">
                @if (before is not null)
                {
                    <a class="prev" href="@Href(before)">
                        <span class="dir">Previous in @sect.Persona</span><b>@before.Title</b><span class="what">@NavText.What(before)</span>
                    </a>
                }
                @if (after is not null)
                {
                    <a class="next" href="@Href(after)">
                        <span class="dir">Next in @sect.Persona</span><b>@after.Title</b><span class="what">@NavText.What(after)</span>
                    </a>
                }
            </nav>
        }
    </main>
</div>
<div id="tip" role="tooltip" hidden></div>
<script src="~/site.js" asp-append-version="true"></script>
@if (wb) { <script src="~/workbench.js" asp-append-version="true"></script> }
</body>
</html>
