@model InsightsPage
@{
    var c = Model.Ctx;
    var path = Context.Request.Path.Value ?? "/";
}
<div class="page-head">
    <div class="eyebrow">@Model.Persona</div>
    <h1>@Model.Title</h1>
    @if (Model.Intro is not null)
    {
        <p class="intro">@Model.Intro</p>
    }
</div>

@if (Model.Stale is not null)
{
    <div class="stale" role="status"><b>Data may be out of date.</b> @Model.Stale</div>
}

@if (Model.Denied is not null)
{
    <div class="denied"><b>Not available to you.</b> @Model.Denied</div>
    return;
}

@if (Model.UsesFilters)
{
    <form class="filters" method="get" action="@path">
        <label>Period
            <select name="d" data-autosubmit>
                @foreach (var d in ReportContext.DayChoices)
                {
                    <option value="@d" selected="@(d == c.Days)">Last @d days</option>
                }
            </select>
        </label>
        @if (c.Root is not null && (c.Root != c.Viewer.Upn || c.Viewer.OrgWide))
        {
            <input type="hidden" name="org" value="@c.Root" />
        }
        @foreach (var k in Context.Request.Query.Keys.Where(k => k is not ("d" or "org" or "handler" or "p")))
        {
            <input type="hidden" name="@k" value="@Context.Request.Query[k]" />
        }
        <div class="crumbs" aria-label="Organisation">
            @if (c.Viewer.OrgWide)
            {
                <a href="@c.Url(path, org: null, keepOrg: false)" class="@(c.Root is null ? "on" : "")">Whole organisation</a>
            }
            @foreach (var u in c.Breadcrumb)
            {
                <span class="sep">›</span><a href="@c.Url(path, org: u.Upn)" class="@(u.Upn == c.Root ? "on" : "")">@u.Name</a>
            }
            @if (c.Children.Count > 0)
            {
                <select aria-label="Look inside" data-navigate>
                    <option value="">Look inside a team</option>
                    @foreach (var k in c.Children)
                    {
                        <option value="@c.Url(path, org: k.Upn)">@k.Name (@k.PeopleBelow.ToString("#,0"))</option>
                    }
                </select>
            }
        </div>
        <span class="period">@c.PeriodLabel</span>
    </form>
    @if (Model.Denied is null && CopilotInsights.Pages.Personal.ViewsModel.SafeUrl(path + Context.Request.QueryString.Value))
    {
        <form class="inline save-view no-print" method="post" action="/me/views?handler=save">
            @Html.AntiForgeryToken()
            <input type="hidden" name="url" value="@(path + Context.Request.QueryString.Value)" />
            <input type="text" name="name" placeholder="Name this view" size="18" maxlength="100" required aria-label="Name for the saved view" />
            <button class="btn quiet" type="submit">Save view</button>
        </form>
    }
}

@if (Model.Notice is not null)
{
    <div class="notice">@Model.Notice</div>
}

@if (Model.Kpis.Count > 0)
{
    <div class="kpis">
        @foreach (var k in Model.Kpis)
        {
            <div class="kpi @(k.Tone)">
                <div class="klabel">@k.Label</div>
                <div class="kvalue">@k.Value</div>
                @if (k.Note is not null)
                {
                    <div class="knote">@k.Note</div>
                }
            </div>
        }
    </div>
}

<div class="panels">
    @foreach (var p in Model.Panels)
    {
        <section class="panel @p.Size">
            <div class="phead">
                <h2>@p.Title</h2>
                @if (p.Csv is not null)
                {
                    <a class="csv" href="@p.Csv">Download CSV</a>
                }
            </div>
            @if (p.Sub is not null)
            {
                <p class="sub">@p.Sub</p>
            }
            @* A chart in a half or third panel is drawn narrower, so its text is the size it is in a full panel. *@
            @(p.Body is CopilotInsights.Charts.ChartSvg chart && p.Size != "full"
                ? new Microsoft.AspNetCore.Html.HtmlString(chart.Render(p.Size.Contains("third") ? 360 : 440))
                : p.Body)
        </section>
    }
</div>
