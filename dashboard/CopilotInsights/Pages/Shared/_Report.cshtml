@model InsightsPage
@{
    var c = Model.Ctx;
    var path = Context.Request.Path.Value ?? "/";
    /* A report says who it is for, what it helps with and what to do, in two lines; the longer
       explanations sit behind information icons (2.4.3). Pages without guidance, the Admin ones,
       keep their text on the page. */
    var guide = CopilotInsights.Pages.Guidance.For(path);
    var who = CopilotInsights.Pages.Nav.SectionFor(path, Model.Viewer, Model.HiddenReports)?.Who;
    /* A phone (theme.js sets the cookie): every chart is drawn for a narrow screen, as the ones in a third of the page are. */
    var narrow = Context.Request.Cookies["narrow"] == "1";
    /* "For executives and department heads", but a name or an abbreviation keeps its capital: Copilot, Microsoft 365, HR, AI. */
    if (who is { Length: > 1 } && !char.IsUpper(who[1]) && who.Split(' ')[0] is not ("Copilot" or "Microsoft")) who = char.ToLowerInvariant(who[0]) + who[1..];
}
<div class="page-head">
    <div class="eyebrow">@Model.Persona</div>
    @if (guide is not null)
    {
        @* The title and who it is for on one line, and what it helps with and what to do on the next, so the figures
           start near the top of the screen. *@
        <div class="ph-title">
            <h1>@InfoTip.After(Model.Title, Model.Intro, "About this page")</h1>
            @if (who is not null)
            {
                <span class="who">For @who</span>
            }
        </div>
        <p class="guide"><span><b>Helps you</b> @guide.Helps</span> <span><b>Do</b> @guide.Do</span></p>
    }
    else
    {
        <h1>@Model.Title</h1>
        @if (Model.Intro is not null)
        {
            <p class="intro">@Model.Intro</p>
        }
    }
</div>

@if (Model.Stale is not null)
{
    <div class="stale" role="status"><b>Data may be out of date.</b> @Model.Stale</div>
}

@if (Model.Denied is not null)
{
    @* What was refused and why, who to ask, and a way on (it stopped at the reason). *@
    <div class="denied"><b>Not available to you.</b> @Model.Denied
        @if (Model.Administrators.Count > 0)
        {
            <p>The dashboard's administrators: @string.Join(", ", Model.Administrators).</p>
        }
        @if (Model.RequestAccess.Count > 0)
        {
            <p>Ask for it: @foreach (var (name, url) in Model.RequestAccess) { <a class="btn" href="@url" rel="noopener noreferrer" target="_blank">Request @name</a> }</p>
        }
        <p><a href="/?home=1">Go to the start page</a> for the reports you can open.</p>
    </div>
    return;
}

@if (Model.UsesFilters && Model.UsesTeam && c.OrgNote is not null)
{
    @* The address asked for a part of the organization that is not the one shown: say so, above the figures. *@
    <div class="notice" role="status">@c.OrgNote</div>
}

@{
    /* A page shows only the controls that change it (2.5.0): the period box where the period matters, the way down the
       organization where the team does. A page that follows neither shows no filter bar. */
    var showPeriodBox = Model.UsesPeriod && Model.OwnWindow is null;
    var showWindow = Model.OwnWindow is not null || Model.UsesPeriod;
}
@if (Model.UsesFilters && (showPeriodBox || showWindow || Model.UsesTeam))
{
    <form class="filters" method="get" action="@path">
        @* A page with a window of its own (today's licenses, the last 30 days whatever the period) has no period to choose
           the box is left out, and the page says what it covers instead. The period chosen elsewhere is kept. *@
        @if (showPeriodBox)
        {
            <label>Period
                <select name="d" data-autosubmit>
                    @foreach (var d in ReportContext.DayChoices)
                    {
                        <option value="@d" selected="@(d == c.Choice)">@ReportContext.ChoiceLabel(d)</option>
                    }
                </select>
            </label>
        }
        else
        {
            <input type="hidden" name="d" value="@c.Choice" />
        }
        @if (c.Root is not null && (c.Root != c.Viewer.Upn || c.Viewer.OrgWide))
        {
            <input type="hidden" name="org" value="@c.Root" />
        }
        @foreach (var k in Context.Request.Query.Keys.Where(k => k is not ("d" or "org" or "handler" or "p")))
        {
            <input type="hidden" name="@k" value="@Context.Request.Query[k]" />
        }
        @* A page the team does not change shows no way down the organization: the links and the box would do nothing. *@
        @if (Model.UsesTeam)
        {
            @* Whose figures the page shows (the names stood with no word saying what they were): the path down the
               organization, each step a link back up, the last one with how many people it covers, then the teams one step further in. *@
            <div class="crumbs" aria-label="Part of the organization shown">
                <span class="lbl">Showing</span>
                @if (c.Viewer.OrgWide)
                {
                    <a href="@c.Url(path, org: null, keepOrg: false)" class="@(c.Root is null ? "on" : "")">Whole organization</a>
                }
                @{ var first = !c.Viewer.OrgWide; }
                @foreach (var u in c.Breadcrumb)
                {
                    @if (!first) { <span class="sep">›</span> }
                    first = false;
                    <a href="@c.Url(path, org: u.Upn)" class="@(u.Upn == c.Root ? "on" : "")">@u.Name@(u.Upn == c.Root && u.PeopleBelow > 0 ? $" and {u.PeopleBelow:#,0} {(u.PeopleBelow == 1 ? "person" : "people")} under them" : "")</a>
                }
                @if (c.Children.Count > 0)
                {
                    <select aria-label="Look inside a team" data-navigate>
                        <option value="">Look inside a team</option>
                        @foreach (var k in c.Children)
                        {
                            <option value="@c.Url(path, org: k.Upn)">@k.Name (@k.PeopleBelow.ToString("#,0") @(k.PeopleBelow == 1 ? "person" : "people"))</option>
                        }
                    </select>
                }
            </div>
        }
        @if (Model.OwnWindow is { } own)
        {
            <span class="period own">Covers @own</span>
        }
        else if (Model.UsesPeriod)
        {
            <span class="period">@c.PeriodLabel</span>
        }
    </form>
}

@if (Model.Notice is not null)
{
    <div class="notice">@Model.Notice</div>
}

@if (Model.Kpis.Count > 0)
{
    <div class="kpis">
        @foreach (var k in Model.Kpis)
        {
            /* A short note with a figure in it ("995 used in the period") stays on the card; words go behind the icon. */
            var figure = k.Note is { Length: <= 40 } kn && kn.Any(char.IsDigit);
            <div class="kpi @(k.Tone)">
                <div class="klabel">@InfoTip.After(k.Label, guide is not null && !figure ? k.Note : null)</div>
                @if (k.Href is not null)
                {
                    @* The figure leads to the report with its detail. *@
                    <a class="kvalue klink" href="@k.Href" title="The detail behind this figure">@k.Value<span class="kgo" aria-hidden="true"> ›</span></a>
                }
                else
                {
                    <div class="kvalue">@k.Value</div>
                }
                @if (k.Note is not null && (guide is null || figure))
                {
                    <div class="knote">@k.Note</div>
                }
                @if (k.Why is { } why)
                {
                    @* How the figure is worked out, and the assumptions it rests on; "Change it" for whoever may. *@
                    <details class="kwhy">
                        <summary>How it is worked out</summary>
                        <p>@why.Formula</p>
                        @if (why.Inputs.Count > 0)
                        {
                            <ul>
                                @foreach (var i in why.Inputs)
                                {
                                    <li>@i.Label: <b>@i.Value</b>@if (i.Href is not null) {<text> · </text><a href="@i.Href">Change it</a>}@Html.Raw(CopilotInsights.Pages.InsightsPage.BasisHtml(i))</li>
                                }
                            </ul>
                        }
                    </details>
                }
            </div>
        }
    </div>
}

<div class="panels">
    @foreach (var p in Model.Panels)
    {
        <section class="panel @p.Size">
            <div class="phead">
                <h2>@InfoTip.After(p.Title, guide is not null ? p.Sub : null)</h2>
                @if (p.Csv is not null)
                {
                    <a class="csv" href="@p.Csv">Download CSV</a>
                }
            </div>
            @if (p.Sub is not null && guide is null)
            {
                <p class="sub">@p.Sub</p>
            }
            @* A chart in a half or third panel is drawn narrower, so its text is the size it is in a full panel. *@
            @(p.Body is CopilotInsights.Charts.ChartSvg chart && (p.Size != "full" || narrow)
                ? new Microsoft.AspNetCore.Html.HtmlString(chart.Render(narrow ? 320 : p.Size.Contains("third") ? 360 : 440))
                : p.Body)
        </section>
    }
</div>
