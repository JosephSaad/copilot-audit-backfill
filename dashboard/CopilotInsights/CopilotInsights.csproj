<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CopilotInsights</RootNamespace>
    <!-- Hosted in IIS on Windows Server: in-process, behind IIS Windows authentication. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.5" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Governance Workbench: its rules, data access, Microsoft and ITSM adapters and notices. Its pages are in
         Pages/Workbench and its web helpers in Workbench/. -->
    <ProjectReference Include="..\..\governance\src\Governance.Infrastructure\Governance.Infrastructure.csproj" />
    <ProjectReference Include="..\..\governance\src\Governance.Notifications\Governance.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests stand in for Microsoft Graph (EntraGraph.Fake). -->
    <InternalsVisibleTo Include="CopilotInsights.Tests" />
  </ItemGroup>

</Project>
