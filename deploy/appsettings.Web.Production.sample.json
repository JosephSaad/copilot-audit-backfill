{
  "_readme": "Copy to appsettings.Web.Production.json, replace every <...> value, and pass it to Install-WorkbenchWeb.ps1 -SettingsFile. No secrets: sign-in uses a certificate selected by subject, SQL uses Windows authentication as the app pool gMSA. Testing switches are off and must stay off.",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant GUID>",
    "ClientId": "<Web app registration client ID for this environment>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc",
    "ClientCertificates": [
      {
        "SourceType": "StoreWithDistinguishedName",
        "CertificateStorePath": "LocalMachine/My",
        "CertificateDistinguishedName": "CN=CopilotGovernanceWeb"
      }
    ]
  },
  "ConnectionStrings": {
    "Governance": "Server=tcp:<AG listener name>,1433;Database=CopilotGovernance;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;MultiSubnetFailover=True;Connect Timeout=30;Application Name=CopilotGovernance-Web"
  },
  "DataProtection": {
    "KeyRingPath": "\\\\<file server>\\CopilotGovernanceKeys$",
    "CertificateThumbprint": "<thumbprint of the key ring protection certificate in LocalMachine\\My>"
  },
  "Workbench": {
    "BaseUrl": "https://<workbench host name>",
    "EnvironmentLabel": "Production"
  },
  "Features": {
    "CostManagementBetaEvidence": false
  },
  "Testing": {
    "AllowActAs": false,
    "TestAuthentication": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "AllowedHosts": "<workbench host name>"
}
