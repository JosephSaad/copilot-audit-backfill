@* One action or information notice. Inline styles only (mail clients drop style sheets). Nothing is carried by
   color alone: the kind of notice is written in words. Links open the Workbench; nothing is approved from email. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@Subject</title>
</head>
<body style="margin:0;padding:0;background:#f4f6fa;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1b2333;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6fa;padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #dde3ee;border-radius:10px;">
                    <tr>
                        <td style="padding:20px 24px 8px 24px;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#4a5875;">
                            @Header · @KindLabel
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:0 24px 8px 24px;font-size:20px;font-weight:600;line-height:1.3;">@Title</td>
                    </tr>
                    <tr>
                        <td style="padding:0 24px 16px 24px;font-size:15px;line-height:1.5;">@Text</td>
                    </tr>
                    @if (Facts.Count > 0)
                    {
                        <tr>
                            <td style="padding:0 24px 16px 24px;">
                                <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;border-top:1px solid #e6eaf2;">
                                    @foreach (var f in Facts)
                                    {
                                        <tr>
                                            <th scope="row" style="text-align:left;padding:8px 12px 8px 0;color:#4a5875;font-weight:600;width:38%;border-bottom:1px solid #e6eaf2;">@f.Key</th>
                                            <td style="padding:8px 0;border-bottom:1px solid #e6eaf2;">@f.Value</td>
                                        </tr>
                                    }
                                </table>
                            </td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(LinkUrl))
                    {
                        <tr>
                            <td style="padding:0 24px 20px 24px;">
                                <a href="@LinkUrl" style="display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-weight:600;padding:10px 18px;border-radius:6px;">@LinkText</a>
                                <div style="font-size:12px;color:#4a5875;padding-top:8px;">Decisions are recorded in the Workbench after you sign in, never by replying to this email.</div>
                            </td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Guidance))
                    {
                        <tr>
                            <td style="padding:0 24px 20px 24px;font-size:13px;line-height:1.5;color:#4a5875;">@Guidance</td>
                        </tr>
                    }
                    <tr>
                        <td style="padding:14px 24px;border-top:1px solid #e6eaf2;font-size:12px;color:#5b6884;">@Footer</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>

@code {
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string Header { get; set; } = "";
    [Parameter] public string KindLabel { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public IReadOnlyList<KeyValuePair<string, string>> Facts { get; set; } = Array.Empty<KeyValuePair<string, string>>();
    [Parameter] public string? LinkUrl { get; set; }
    [Parameter] public string LinkText { get; set; } = "Open in the Workbench";
    [Parameter] public string? Guidance { get; set; }
    [Parameter] public string Footer { get; set; } = "";
}
