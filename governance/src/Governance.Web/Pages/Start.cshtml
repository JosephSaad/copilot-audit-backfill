@page "/Start"
@model StartModel
@{
    ViewData["Title"] = "Start";
}
<div class="page-head">
    <div>
        <h1>Hello, @Model.Principal.DisplayName</h1>
        <p class="lead">Start here. Pick what you need below; each tile says who it is for and how long it usually takes. Everything you are waiting on, or waiting for you, is in <a href="/MyWork">My work</a>.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost" href="/MyWork">My work <span class="pill pill-info">@Model.OpenTasks open</span></a>
        <a class="btn btn-ghost" href="/Requests?mine=true">My requests <span class="pill pill-info">@Model.MyRequests</span></a>
    </div>
</div>

@if (!Model.IntakeOpen)
{
    <div class="alert alert-warn" role="status">
        <strong>New requests are not open yet.</strong> The Platform Owner opens intake once the foundation is in place (funding owners, catalog, templates, commercial inventory, standards, discovery and envelopes). You can still look around, report a consumption problem and use approved services through Entra.
    </div>
}

@foreach (var r in Model.PendingRoles)
{
    <div class="card">
        <div class="card-head">
            <h2>You were named @r.RoleName@(r.Scope is null ? "" : $" for {r.Scope}")</h2>
            <form method="post" asp-page-handler="Accept" asp-route-id="@r.PublicId"><idem /><button class="btn" type="submit">Accept the role</button></form>
        </div>
        <p class="muted">Accepting means you hold the business case, funding and continuity decisions for this funding owner, and the delegated approvers act within the envelopes you approve. A funding owner cannot become active until its business owner accepts.</p>
    </div>
}

<h2>What do you need? <help k="start.tiles">Each tile starts one of the eight journeys of the operating model. You only see the ones your roles allow. The time shown is the usual turnaround with the standard service levels.</help></h2>
<div class="tiles">
    @foreach (var t in Model.Tiles.Where(t => Model.Visible(t.JourneyCode)))
    {
        var closed = !Model.IntakeOpen && Journeys.WithStages.Contains(t.JourneyCode);
        <a class="tile @(closed ? "disabled" : "")" href="@Model.Link(t.JourneyCode)" aria-disabled="@(closed ? "true" : null)">
            <span class="tile-code">@t.JourneyCode</span>
            <span class="tile-name">@t.Name</span>
            <span class="tile-desc">@t.Description</span>
            <span class="tile-meta">For: @t.TypicalUser · @t.Turnaround@(closed ? " · opens with intake" : "")</span>
        </a>
    }
</div>

@if (Model.ShowSetup)
{
    <div class="card mt">
        <div class="card-head">
            <h2>Program setup <help k="start.setup">Intake (B1) stays closed until steps 0 to 7 are complete. These steps are the entry criteria at the end of section A of the process: the institution builds the foundation once, before anyone can ask for anything.</help></h2>
            <span class="muted small">@Model.Setup.Count(s => s.Done) of @Model.Setup.Count done</span>
        </div>
        @if (Model.IntakeOpen && Model.Setup.Any(s => s.Step < 8 && !s.Done))
        {
            <p class="alert alert-warn" role="status"><strong>Warning.</strong> Intake is open, but these foundation steps are not done: @string.Join(", ", Model.Setup.Where(s => s.Step < 8 && !s.Done).Select(s => $"step {s.Step}")). Finish them, or close intake until they are.</p>
        }
        <ul class="checklist">
            @foreach (var s in Model.Setup)
            {
                <li>
                    <span class="mark @(s.Done ? "mark-ok" : "mark-no")" aria-hidden="true">@(s.Done ? "✓" : s.Step.ToString())</span>
                    <div>
                        <div><strong>Step @s.Step.</strong> <a href="@s.Link">@s.What</a> <span class="sr-only">@(s.Done ? "done" : "not done")</span></div>
                        <div class="small muted">Accountable: @s.Accountable · Screen: @s.Screen · @s.Status</div>
                    </div>
                </li>
            }
        </ul>
    </div>
}
