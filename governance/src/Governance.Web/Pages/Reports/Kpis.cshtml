@page "/Reports/Kpis"
@model Governance.Web.Pages.Reports.KpisModel
@{
    ViewData["Title"] = "Governance KPIs";
}
<div class="page-head">
    <div>
        <div class="crumbs">Reports</div>
        <h1>Governance KPIs</h1>
        <p class="lead">The Phase 1 measures from the operating model: ownership, approved routes, response, recertification and unapproved usage. Each figure says how it is worked out and where it comes from. Finance KPIs (forecast error, P3 burn-down, PAYG share, reconciliation) arrive with the Phase 2 usage ledger.</p>
    </div>
    <div class="page-actions"><a class="btn btn-ghost" href="@Ui.CsvHref(ViewContext.HttpContext.Request)">Export CSV</a></div>
</div>
<p class="small muted">As of @Ui.Local(Model.AsOf) · source: Workbench database (computed now)</p>
<div class="grid grid-3">
    @foreach (var k in Model.Kpis)
    {
        var def = Governance.Web.Pages.Reports.KpisModel.Definitions.TryGetValue(k.KpiCode, out var d) ? d : ("", "");
        // Counts, not rates: shared-service exhaustion is a number of events in 90 days.
        var isCount = k.KpiCode is "SHARED_EXHAUSTION_RISK" or "UNAPPROVED_FINDINGS";
        var isRatio = k.Denominator is not null && !isCount;
        var pct = isRatio && k.Denominator > 0 ? Math.Round(100m * (k.Numerator ?? 0) / k.Denominator!.Value, 1) : (decimal?)null;
        var link = k.KpiCode switch
        {
            "OWNERSHIP_COVERAGE" or "APPROVED_ROUTE" => "/Registry/Workloads",
            "THRESHOLD_RESPONSE" or "SHARED_EXHAUSTION_RISK" => "/Operations/Events?open=false",
            "RECERT_COMPLETION" or "OUTCOME_EVIDENCE" => "/Recertification?all=true",
            "UNAPPROVED_FINDINGS" => "/Operations/Findings",
            _ => null,
        };
        var note = isCount
            ? (k.KpiCode == "SHARED_EXHAUSTION_RISK" ? $"exhaustion events on critical shared services, last 90 days (of {Ui.Num(k.Denominator)} events)" : "open now")
            : $"{Ui.Num(k.Numerator ?? 0)} of {Ui.Num(k.Denominator)}";
        <div class="stat">
            <div class="stat-label">@k.Name <help>@def.Item1 Source: @def.Item2.@(link is null ? "" : " Select the figure to see the list it counts.")</help></div>
            @if (link is not null)
            {
                <a class="kpi-link" href="@link" aria-label="@k.Name: open the list it counts">
                    <div class="stat-value">@(isRatio ? (pct is null ? "No data" : pct + "%") : Ui.Num(k.Numerator ?? 0))</div>
                    <div class="stat-note">@note</div>
                </a>
            }
            else
            {
                <div class="stat-value">@(isRatio ? (pct is null ? "No data" : pct + "%") : Ui.Num(k.Numerator ?? 0))</div>
                <div class="stat-note">@note</div>
            }
        </div>
    }
</div>
