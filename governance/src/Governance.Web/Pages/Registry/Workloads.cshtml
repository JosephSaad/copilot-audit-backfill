@page "/Registry/Workloads"
@model Governance.Web.Pages.Registry.WorkloadsModel
@{
    ViewData["Title"] = "Workloads";
    var states = new[] { "", "REGISTERED", "DEVELOPMENT", "TEST", "PRODUCTION", "SUSPENDED", "RETIRING", "RETIRED", "DISCOVERED" };
}
<div class="page-head">
    <div>
        <div class="crumbs">Registry</div>
        <h1>Workloads</h1>
        <p class="lead">The governed units: agents, environments, agent flows and service entitlement cohorts, each with one funding owner and four independent classification fields. You see the workloads of the funding owners where you hold a role.</p>
    </div>
</div>
<form method="get" class="btn-row mb0">
    <label for="st">Status <help>Discovered, registered, a build stage, production, suspended or retired.</help></label>
    <select id="st" name="state">@foreach (var s in states) { <option value="@s" selected="@(s == (Model.State ?? ""))">@(s == "" ? "All" : Ui.Words(s))</option> }</select>
    <button class="btn btn-small btn-ghost" type="submit">Filter</button>
</form>
<partial name="_Search" model="Model.Search" />
<div class="table-wrap">
    <table class="stack">
        <thead>
        <tr>
            <partial name="_Th" model='("name", "Workload", "Name and type.")' />
            <partial name="_Th" model='("owner", "Funding owner", "Who pays, with the cost center.")' />
            <partial name="_Th" model='("service", "Service", "The catalog service and route.")' />
            <partial name="_Th" model='("stage", "Classification", "Lifecycle stage, solution class and criticality, each answered on its own (C03).")' />
            <partial name="_Th" model='("state", "Status", "Discovered, registered, builder stages, production, suspended, retiring or retired.")' />
            <partial name="_Th" model='("review", "Next review", "From the last approval or recertification.")' />
        </tr>
        </thead>
        <tbody>
        @foreach (var w in Model.Items.Items)
        {
            <tr>
                <td><a href="/Registry/Workloads/@w.PublicId"><strong>@w.Name</strong></a><div class="small muted">@Ui.Words(w.WorkloadType)</div></td>
                <td>@w.FundingOwnerName<div class="small muted">@w.CostCenterCode</div></td>
                <td>@(w.ServiceName ?? "—")</td>
                <td class="small">@Ui.Words(w.LifecycleStage) · @Ui.Words(w.SolutionClass) · @Ui.Words(w.Criticality)</td>
                <td>@Ui.Pill(w.State)</td>
                <td>@Ui.Date(w.NextReviewOn)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Pager" model="(Model.Items.Query.Page, Model.Items.Pages, Model.Items.Total)" />
