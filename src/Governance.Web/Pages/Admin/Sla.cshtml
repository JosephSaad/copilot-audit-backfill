@page "/Admin/Sla"
@model Governance.Web.Pages.Admin.SlaModel
@{
    ViewData["Title"] = "SLAs and escalation";
}
<div class="page-head">
    <div>
        <div class="crumbs">Admin</div>
        <h1>Service levels and escalation</h1>
        <p class="lead">Proposed defaults from the operating model; calibrate them during the six-week validation. Reminders go out at 50 and 80 percent of the time; at 100 percent a task escalates one level up its ladder. Business-day levels skip weekends and institutional holidays.</p>
    </div>
</div>
<div class="table-wrap">
    <table class="stack">
        <thead><tr><th scope="col">Service level</th><th scope="col">Duration</th><th scope="col">Calendar <help>Business days, or around the clock for operational events with after-hours coverage (OD7).</help></th><th scope="col">Reminders</th><th scope="col"><span class="sr-only">Change</span></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Policies)
        {
            <tr>
                <td><strong>@p.Name</strong><div class="small muted mono">@p.SlaPolicyCode</div></td>
                <td>@p.Duration @(p.Unit == "H" ? "hours" : p.Unit == "BD" ? "business days" : "days")</td>
                <td>@Ui.Words(p.Calendar)</td>
                <td>@p.RemindAtPct1% and @p.RemindAtPct2%</td>
                <td>@if (Model.Principal.HasCentral(Roles.PlatformOwner)) { <form method="post" asp-route-code="@p.SlaPolicyCode" class="btn-row"><idem /><input type="number" name="duration" value="@p.Duration" min="0" max="90" aria-label="New duration for @p.Name" /><button class="btn btn-small btn-ghost" type="submit">Change</button></form> }</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<h2 class="mt">Escalation ladders</h2>
<div class="table-wrap">
    <table class="stack">
        <thead><tr><th scope="col">Ladder</th><th scope="col">Level</th><th scope="col">Goes to</th><th scope="col">Scope</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Ladders)
        {
            <tr><td>@Ui.Words(l.LadderCode)</td><td>@l.Level</td><td>@Ui.Words(l.RoleCode)</td><td>@(l.ScopeKind == "TENANT" ? "Central" : "The request's funding owner")</td></tr>
        }
        </tbody>
    </table>
</div>
