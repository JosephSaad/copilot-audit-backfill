@page "/Admin/Intake"
@model Governance.Web.Pages.Admin.IntakeModel
@{
    ViewData["Title"] = "Intake switch";
    var ready = Model.Steps.Where(s => s.Step < 8).All(s => s.Done);
}
<div class="page-head">
    <div>
        <div class="crumbs">Admin</div>
        <h1>Intake switch</h1>
        <p class="lead">Intake opens once the foundation is built: decision rights, funding owners, catalogue, templates, commercial inventory, standards, discovery and envelopes. Opening it without discovery leaves unowned agents and environments outside the process. Only the Platform Owner opens or closes intake. <help>Process references: B1; section 4.1.</help></p>
    </div>
</div>
<div class="card">
    <div class="card-head">
        <h2>Intake is @(Model.Open ? "open" : "closed") @(Model.Open ? Ui.Pill("OPEN", "ok") : Ui.Pill("CLOSED", "warn"))</h2>
        @if (Model.Principal.HasCentral(Roles.PlatformOwner))
        {
            <form method="post" asp-page-handler="Switch" asp-route-open="@(!Model.Open)" data-confirm="@(Model.Open ? "Close intake? New requests stop; existing ones continue." : "Open intake? The Start page accepts new requests.")">
                <idem />
                <button class="btn @(Model.Open ? "btn-ghost" : "")" type="submit" disabled="@(!Model.Open && !ready)">@(Model.Open ? "Close intake" : "Open intake")</button>
            </form>
        }
    </div>
    <ul class="checklist">
        @foreach (var s in Model.Steps)
        {
            <li><span class="mark @(s.Done ? "mark-ok" : "mark-no")" aria-hidden="true">@(s.Done ? "✓" : s.Step.ToString())</span><div><div><strong>Step @s.Step.</strong> <a href="@s.Link">@s.What</a> <span class="sr-only">@(s.Done ? "done" : "not done")</span></div><div class="small muted">Accountable: @s.Accountable · @s.Status</div>
                @if (s.Step == 5 && !s.Done && Model.Principal.HasCentral(Roles.PlatformOwner))
                {
                    <form method="post" asp-page-handler="Standards" class="mt"><idem /><button class="btn btn-small btn-ghost" type="submit">Approve the standards now</button> <span class="small muted">Review <a href="/Admin/Sla">service levels</a> and <a href="/Admin/Notifications">notification recipients</a> first.</span></form>
                }</div></li>
        }
    </ul>
</div>
