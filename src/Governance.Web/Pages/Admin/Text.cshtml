@page "/Admin/Text"
@model Governance.Web.Pages.Admin.TextModel
@{
    ViewData["Title"] = "Wording";
}
<div class="page-head">
    <div>
        <div class="crumbs">Admin</div>
        <h1>Wording</h1>
        <p class="lead">Business wording the Platform Owner changes between releases without a code change: the help text behind any (i) icon that has a key, and notification headers. An administrator drafts; the Platform Owner approves; the approved version shows at once.</p>
    </div>
</div>
<form method="post" asp-page-handler="Save" class="card">
    <idem />
    <h2>Draft wording</h2>
    <div class="form-grid">
        <div class="field"><label for="tk" class="req">Key <help>For example req.fundingowner, start.tiles, fo.checklist, sync.inventory, tpl.settings, wl.posture.</help></label><input id="tk" name="key" required maxlength="120" /></div>
        <div class="field full"><label for="tb" class="req">Text <help>The wording people see.</help></label><textarea id="tb" name="body" required maxlength="4000"></textarea></div>
    </div>
    <button class="btn btn-ghost mt" type="submit">Save draft</button>
</form>
<div class="table-wrap">
    <table class="stack">
        <thead><tr><th scope="col">Key <help>Where the wording appears, for example a page's guidance text.</help></th><th scope="col">Version <help>Each change is a new version; the Platform Owner approves it before it shows.</help></th><th scope="col">Text <help>The wording people see.</help></th><th scope="col">Status <help>Draft wording is not shown until approved.</help></th><th scope="col"><span class="sr-only">Approve</span></th></tr></thead>
        <tbody>
        @foreach (var b in Model.Blocks)
        {
            <tr>
                <td class="mono">@b.TextKey</td><td>Version @(b.VersionNo)</td><td>@b.Body</td><td>@Ui.Pill(b.Status)</td>
                <td>@if (b.Status == "DRAFT" && Model.Principal.HasCentral(Roles.PlatformOwner)) { <form method="post" asp-page-handler="Approve" asp-route-key="@b.TextKey" asp-route-version="@b.VersionNo"><idem /><button class="btn btn-small" type="submit">Approve</button></form> }</td>
            </tr>
        }
        </tbody>
    </table>
</div>
