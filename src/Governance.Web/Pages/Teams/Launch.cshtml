@page "/Teams/Launch"
@model Governance.Web.Pages.TeamsLaunchModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Governance Workbench</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<main class="main">
    <div class="card">
        <h1>Governance Workbench</h1>
        <p>Decisions are made in the Workbench, never in Teams. Open the item in your browser, where you sign in as usual.</p>
        <p><a class="btn" href="@Model.Target" target="_blank" rel="noopener">Open in the browser</a></p>
    </div>
</main>
</body>
</html>
