@* The daily digest (N17): informed items, one line each, with a link. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@Title</title>
</head>
<body style="margin:0;padding:0;background:#f4f6fa;font-family:Segoe UI,Helvetica,Arial,sans-serif;color:#1b2333;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6fa;padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border:1px solid #dde3ee;border-radius:10px;">
                    <tr><td style="padding:20px 24px 8px 24px;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:#4a5875;">@Header · Daily digest</td></tr>
                    <tr><td style="padding:0 24px 8px 24px;font-size:20px;font-weight:600;">@Title</td></tr>
                    <tr><td style="padding:0 24px 12px 24px;font-size:14px;color:#4a5875;">@Intro</td></tr>
                    <tr>
                        <td style="padding:0 24px 20px 24px;">
                            <ul style="margin:0;padding-left:18px;font-size:14px;line-height:1.6;">
                                @foreach (var item in Items)
                                {
                                    <li style="margin-bottom:6px;">
                                        @item.Text
                                        @if (!string.IsNullOrEmpty(item.Url))
                                        {
                                            <text> </text><a href="@item.Url" style="color:#1d4ed8;">Open</a>
                                        }
                                    </li>
                                }
                            </ul>
                        </td>
                    </tr>
                    <tr><td style="padding:14px 24px;border-top:1px solid #e6eaf2;font-size:12px;color:#5b6884;">@Footer</td></tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>

@code {
    public sealed record Item(string Text, string? Url);
    [Parameter] public string Header { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Intro { get; set; } = "";
    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    [Parameter] public string Footer { get; set; } = "";
}
